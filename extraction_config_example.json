{
  "extractors": {
    "aadt": {
      "strategies": [
        {
          "name": "table_with_aadt_header",
          "selector": "table:has(th:contains('AADT'), td:contains('AADT'))",
          "columns": {
            "year": ["year", "yr"],
            "aadt": ["aadt", "average daily traffic"],
            "dhv": ["dhv", "dhv-30"]
          }
        },
        {
          "name": "section_based",
          "sectionMarker": "AADT",
          "tableSelector": "table",
          "skipRows": 1
        }
      ]
    },
    "volumeCount": {
      "strategies": [
        {
          "name": "volume_section",
          "sectionMarker": "VOLUME COUNT",
          "dateColumn": 0,
          "intervalColumn": 1,
          "totalColumn": 2
        }
      ]
    }
  }
}