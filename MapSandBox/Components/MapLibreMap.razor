@using Microsoft.JSInterop
@using MapSandBox.Models
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div style="position: relative; width: 100%; height: 100%;">
    <div id="@MapContainerId" style="width: 100%; height: 100%;"></div>
    
    <!-- Zoom Level Indicator -->
    <div style="position: absolute; bottom: 10px; left: 10px; background: rgba(0,0,0,0.7); color: white; padding: 8px 12px; border-radius: 4px; font-family: monospace; font-size: 14px; z-index: 1000;">
        Zoom: <span id="@($"{MapContainerId}-zoom")">--</span>
    </div>
</div>

@code {
    [Parameter] public string MapContainerId { get; set; } = "maplibre-container";
    [Parameter] public MapLibreConfig Config { get; set; } = new();
    [Parameter] public EventCallback<MapLibreClickEventArgs> OnMapClick { get; set; }
    
    private IJSObjectReference? _module;
    private IJSObjectReference? _mapInstance;
    private bool _isUpdatingLayers = false;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeMap();
        }
    }
    
    private async Task InitializeMap()
    {
        try
        {
            Console.WriteLine("[MapLibre] Initializing integrated map...");
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/maplibre-deckgl-integration.js");
            Console.WriteLine("[MapLibre] JavaScript module loaded successfully");

            _mapInstance = await _module.InvokeAsync<IJSObjectReference>("createIntegratedMap", MapContainerId, Config);
            Console.WriteLine("[MapLibre] Integrated map instance created successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MapLibre] Error initializing map: {ex.Message}");
            Console.WriteLine($"[MapLibre] Stack trace: {ex.StackTrace}");
            throw;
        }
    }
    
    public async Task UpdateLayers(List<LayerConfig> layers)
    {
        try
        {
            Console.WriteLine($"[MapLibre] UpdateLayers called with {layers?.Count ?? 0} layers");

            // Prevent race conditions from rapid layer toggles
            if (_isUpdatingLayers)
            {
                Console.WriteLine("[MapLibre] Warning: Layer update already in progress, skipping to prevent race condition");
                return;
            }

            _isUpdatingLayers = true;

            if (_module == null)
            {
                Console.WriteLine("[MapLibre] Warning: Module not initialized, skipping layer update");
                return;
            }

            if (_mapInstance == null)
            {
                Console.WriteLine("[MapLibre] Warning: Map instance not initialized, skipping layer update");
                return;
            }

            Console.WriteLine($"[MapLibre] Updating layers: {string.Join(", ", layers.Select(l => $"{l.Id}({l.Visible})"))}");
            await _module.InvokeVoidAsync("updateIntegratedMapLayers", _mapInstance, layers);
            Console.WriteLine("[MapLibre] Layer update completed successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MapLibre] Error updating layers: {ex.Message}");
            Console.WriteLine($"[MapLibre] Stack trace: {ex.StackTrace}");

            // Don't re-throw here to prevent cascading failures - log and continue
            Console.WriteLine("[MapLibre] Continuing execution after layer update error");
        }
        finally
        {
            _isUpdatingLayers = false;
        }
    }
    
    public async Task UpdateBaseMapStyle(string styleUrl)
    {
        try
        {
            Console.WriteLine($"[MapLibre] UpdateBaseMapStyle called with: {styleUrl}");

            if (_module == null)
            {
                Console.WriteLine("[MapLibre] Warning: Module not initialized, skipping base map update");
                return;
            }

            if (_mapInstance == null)
            {
                Console.WriteLine("[MapLibre] Warning: Map instance not initialized, skipping base map update");
                return;
            }

            await _module.InvokeVoidAsync("updateBaseMapStyle", _mapInstance, styleUrl);
            Console.WriteLine("[MapLibre] Base map style updated successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MapLibre] Error updating base map style: {ex.Message}");
            Console.WriteLine($"[MapLibre] Stack trace: {ex.StackTrace}");

            // Don't re-throw here to prevent cascading failures
            Console.WriteLine("[MapLibre] Continuing execution after base map update error");
        }
    }
    
    public async ValueTask DisposeAsync()
    {
        if (_mapInstance != null && _module != null)
        {
            await _module.InvokeVoidAsync("disposeIntegratedMap", _mapInstance);
        }
        
        if (_module != null)
        {
            await _module.DisposeAsync();
        }
    }
}