@* Flat stroke icon set — replaces emoji throughout the detail panels.
   All icons: 24px viewBox, currentColor stroke, no fill, consistent
   1.7 stroke weight. Size via the Size parameter (default 15). *@
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="@Size" height="@Size"
     fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
     stroke-linejoin="round" aria-hidden="true" class="mueny-icon">
    @switch (Name)
    {
        case "car":
            <path d="M4 16v-3l2-5.5A1.5 1.5 0 0 1 7.4 6.5h9.2a1.5 1.5 0 0 1 1.4 1L20 13v3" />
            <path d="M4 13h16" />
            <circle cx="7.5" cy="16.5" r="1.6" />
            <circle cx="16.5" cy="16.5" r="1.6" />
            break;
        case "impact":
            <path d="M12 3.5 20.5 12 12 20.5 3.5 12Z" />
            <path d="M12 8.5v4.5" />
            <path d="M12 16.2v.1" />
            break;
        case "traffic":
            <path d="M5 19v-6" />
            <path d="M12 19V9" />
            <path d="M19 19V5" />
            break;
        case "rain":
            <path d="M12 4c3.4 4.1 5.8 7 5.8 9.7a5.8 5.8 0 0 1-11.6 0C6.2 11 8.6 8.1 12 4Z" />
            break;
        case "weather":
            <path d="M6.8 18.5a4.2 4.2 0 0 1-.5-8.4A5.4 5.4 0 0 1 16.8 9a4.3 4.3 0 0 1 .9 9.5Z" />
            break;
        case "warning":
            <path d="M12 4.5 21 19.5H3Z" />
            <path d="M12 10.2v4" />
            <path d="M12 16.8v.1" />
            break;
        case "check":
            <circle cx="12" cy="12" r="8.4" />
            <path d="m8.4 12.4 2.4 2.4 4.8-5.2" />
            break;
        case "people":
            <circle cx="9" cy="8.5" r="3" />
            <path d="M3.5 19a5.5 5.5 0 0 1 11 0" />
            <path d="M15.4 5.9a3 3 0 0 1 0 5.2" />
            <path d="M17 13.7A5.5 5.5 0 0 1 20.5 19" />
            break;
        case "location":
            <path d="M12 21c-4-4.2-6-7.3-6-10a6 6 0 1 1 12 0c0 2.7-2 5.8-6 10Z" />
            <circle cx="12" cy="11" r="2.2" />
            break;
        case "slope":
            <path d="m3 19 6.5-11 4 6.5L16 11l5 8Z" />
            break;
        case "gear":
            <path d="M5 8h9M18 8h1M5 16h1M10 16h9" />
            <circle cx="16" cy="8" r="2" />
            <circle cx="8" cy="16" r="2" />
            break;
        case "search":
            <circle cx="11" cy="11" r="6.5" />
            <path d="m16 16 4.5 4.5" />
            break;
        case "refresh":
            <path d="M20 12a8 8 0 1 1-2.3-5.6" />
            <path d="M20 4v4h-4" />
            break;
        default:
            <circle cx="12" cy="12" r="8.4" />
            break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 15;
}
