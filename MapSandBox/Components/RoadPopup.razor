@using MapSandBox.Models
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if (IsVisible && RoadData != null)
{
    <div class="cris-popup-overlay" @onclick="Hide">
        <div class="cris-popup-card" @onclick:stopPropagation="true">
            <div class="popup-header">
                <h4>🛣️ @RoadData.RoadName</h4>
                <button class="close-btn" @onclick="Hide">×</button>
            </div>

            <div class="road-overview">
                <div class="road-type-display">
                    <span class="road-type">@RoadData.RoadTypeName</span>
                    <span class="road-code">@RoadData.RoadType</span>
                </div>
            </div>

            <div class="road-breakdown">
                <h5>🚦 Road Information</h5>
                @if (RoadData.HasTrafficData)
                {
                    <div class="detail-item">
                        <div class="detail-header">
                            <span class="detail-icon">🚦</span>
                            <span class="detail-label">Traffic Data</span>
                        </div>
                        <div class="traffic-stats">
                            <div class="traffic-stat">
                                <div class="stat-value">@RoadData.FormattedAADT</div>
                                <div class="stat-label">AADT (@RoadData.AADTYear)</div>
                            </div>
                            @if (RoadData.DHV30.HasValue)
                            {
                                <div class="traffic-stat">
                                    <div class="stat-value">@RoadData.DHV30.Value.ToString("N0")</div>
                                    <div class="stat-label">DHV 30th Hour</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(RoadData.LocationId))
                {
                    <div class="detail-item">
                        <div class="detail-header">
                            <span class="detail-icon">📍</span>
                            <span class="detail-label">Traffic Location</span>
                        </div>
                        <div class="detail-value">@RoadData.LocationId</div>
                        @if (!string.IsNullOrEmpty(RoadData.LocatedOn) && RoadData.LocatedOn != "-")
                        {
                            <div class="location-sublabel">Located on: @RoadData.LocatedOn</div>
                        }
                    </div>
                }

                <div class="detail-item">
                    <div class="detail-header">
                        <span class="detail-icon">🔧</span>
                        <span class="detail-label">Technical Information</span>
                    </div>
                    <div class="technical-details">
                        @if (!string.IsNullOrEmpty(RoadData.LinearId))
                        {
                            <div class="technical-item">
                                <span class="technical-label">Linear ID:</span>
                                <span class="technical-value mono">@RoadData.LinearId</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(RoadData.MTFCC))
                        {
                            <div class="technical-item">
                                <span class="technical-label">MTFCC:</span>
                                <span class="technical-value mono">@RoadData.MTFCC</span>
                            </div>
                        }
                        <div class="technical-item">
                            <span class="technical-label">Coordinates:</span>
                            <span class="technical-value mono">@RoadData.FormattedCoordinates</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public RoadPopupData? RoadData { get; set; }
    [Parameter] public EventCallback OnHide { get; set; }

    private DotNetObjectReference<RoadPopup>? _objectReference;
    private IJSObjectReference? _jsModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/roadPopup.js");
            _objectReference = DotNetObjectReference.Create(this);
            await _jsModule.InvokeVoidAsync("setRoadPopupInstance", _objectReference);
        }
    }

    public void Show(RoadPopupData data)
    {
        RoadData = data;
        IsVisible = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void ShowPopupFromJS(RoadPopupData data)
    {
        Show(data);
    }

    public async Task Hide()
    {
        IsVisible = false;
        await OnHide.InvokeAsync();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule != null && _objectReference != null)
        {
            await _jsModule.InvokeVoidAsync("clearRoadPopupInstance");
            _objectReference.Dispose();
            await _jsModule.DisposeAsync();
        }
    }
}