@using MapSandBox.Models
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if (IsVisible && CrashData != null)
{
    <div class="cris-popup-overlay" @onclick="Hide">
        <div class="cris-popup-card" @onclick:stopPropagation="true">
            <div class="popup-header">
                <h4>🚗 Crash Report #@CrashData.CrashId</h4>
                <button class="close-btn" @onclick="Hide">×</button>
            </div>

            <div class="crash-overview">
                <div class="crash-summary-display">
                    <span class="crash-date">@CrashData.CrashDateTime</span>
                    <span class="severity-level severity-@CrashData.SeverityCode.ToLower()">@CrashData.Severity (@CrashData.SeverityCode)</span>
                </div>
            </div>

            <div class="crash-breakdown">
                <h5>📊 Crash Details</h5>

                        <div class="detail-item">
                            <div class="detail-header">
                                <span class="detail-icon">👥</span>
                                <span class="detail-label">People & Vehicles</span>
                            </div>
                            <div class="detail-value">
                                @CrashData.PersonsInvolved persons, @CrashData.VehiclesInvolved vehicles
                            </div>
                            @if (CrashData.FatalCount > 0 || CrashData.InjuryCount > 0)
                            {
                                <div class="detail-casualties">
                                    @if (CrashData.FatalCount > 0)
                                    {
                                        <span class="casualty-count fatal">@CrashData.FatalCount fatalities</span>
                                    }
                                    @if (CrashData.InjuryCount > 0)
                                    {
                                        <span class="casualty-count injury">@CrashData.InjuryCount injuries</span>
                                    }
                                </div>
                            }
                        </div>

                        <div class="detail-item">
                            <div class="detail-header">
                                <span class="detail-icon">🌦️</span>
                                <span class="detail-label">Conditions</span>
                            </div>
                            <div class="condition-grid">
                                <div class="condition-item">
                                    <span class="condition-type">Weather:</span>
                                    <span class="condition-value">@CrashData.WeatherCondition</span>
                                </div>
                                <div class="condition-item">
                                    <span class="condition-type">Lighting:</span>
                                    <span class="condition-value">@CrashData.LightCondition</span>
                                </div>
                                <div class="condition-item">
                                    <span class="condition-type">Surface:</span>
                                    <span class="condition-value">@CrashData.SurfaceCondition</span>
                                </div>
                            </div>
                        </div>

                        @if (CrashData.ContributingFactors?.Any() == true)
                        {
                            <div class="detail-item">
                                <div class="detail-header">
                                    <span class="detail-icon">⚠️</span>
                                    <span class="detail-label">Contributing Factors</span>
                                </div>
                                <div class="factors-list">
                                    @foreach (var factor in CrashData.ContributingFactors)
                                    {
                                        <div class="factor-item">@factor</div>
                                    }
                                </div>
                            </div>
                        }

                        @if (CrashData.SlopeAtLocation > 0)
                        {
                            <div class="detail-item">
                                <div class="detail-header">
                                    <span class="detail-icon">🏔️</span>
                                    <span class="detail-label">Road Slope</span>
                                </div>
                                <div class="slope-details">
                                    <div class="slope-item">
                                        <span class="slope-label">Grade:</span>
                                        <span class="slope-value">@CrashData.SlopeAtLocation.ToString("F1")°</span>
                                        <span class="slope-percentage">(@CrashData.SlopePercentage.ToString("F1")%)</span>
                                    </div>
                                    <div class="slope-item">
                                        <span class="slope-label">Category:</span>
                                        <span class="slope-category slope-@CrashData.SlopeCategory.ToLower()">@CrashData.SlopeCategory</span>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="detail-item">
                            <div class="detail-header">
                                <span class="detail-icon">📍</span>
                                <span class="detail-label">Location</span>
                            </div>
                            <div class="location-details">
                                <div class="location-item">
                                    <span class="location-label">Coordinates:</span>
                                    <span class="location-value mono">@CrashData.FormattedCoordinates</span>
                                </div>
                                @if (!string.IsNullOrEmpty(CrashData.RoadwayId))
                                {
                                    <div class="location-item">
                                        <span class="location-label">Roadway ID:</span>
                                        <span class="location-value mono">@CrashData.RoadwayId</span>
                                    </div>
                                }
                            </div>
                        </div>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public CrashPopupData? CrashData { get; set; }
    [Parameter] public EventCallback OnHide { get; set; }

    private DotNetObjectReference<CrashPopup>? _objectReference;
    private IJSObjectReference? _jsModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/crashPopup.js");
            _objectReference = DotNetObjectReference.Create(this);
            await _jsModule.InvokeVoidAsync("setCrashPopupInstance", _objectReference);
        }
    }

    public void Show(CrashPopupData data)
    {
        CrashData = data;
        IsVisible = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void ShowPopupFromJS(CrashPopupData data)
    {
        Show(data);
    }

    public async Task Hide()
    {
        IsVisible = false;
        await OnHide.InvokeAsync();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule != null && _objectReference != null)
        {
            await _jsModule.InvokeVoidAsync("clearCrashPopupInstance");
            _objectReference.Dispose();
            await _jsModule.DisposeAsync();
        }
    }
}