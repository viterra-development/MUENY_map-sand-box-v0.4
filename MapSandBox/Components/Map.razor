@using Microsoft.JSInterop
@using MapSandBox.Models
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div id="@MapContainerId" style="width: 100%; height: 100%;"></div>

@code {
    [Parameter] public string MapContainerId { get; set; } = "map-container";
    [Parameter] public MapConfig Config { get; set; } = new();
    [Parameter] public EventCallback<MapClickEventArgs> OnMapClick { get; set; }
    
    private IJSObjectReference? _module;
    private IJSObjectReference? _mapInstance;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeMap();
        }
    }
    
    private async Task InitializeMap()
    {
        _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/map.js");
        _mapInstance = await _module.InvokeAsync<IJSObjectReference>("createMap", MapContainerId, Config);
    }
    
    public async Task UpdateLayers(List<LayerConfig> layers)
    {
        if (_module != null)
        {
            await _module.InvokeVoidAsync("updateMapLayers", _mapInstance, layers);
        }
    }
    
    public async ValueTask DisposeAsync()
    {
        if (_mapInstance != null && _module != null)
        {
            await _module.InvokeVoidAsync("disposeMap", _mapInstance);
        }
    }
} 