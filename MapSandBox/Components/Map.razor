@using Microsoft.JSInterop
@using MapSandBox.Models
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div id="@MapContainerId" style="width: 100%; height: 100%;"></div>

@code {
    [Parameter] public string MapContainerId { get; set; } = "map-container";
    [Parameter] public MapConfig Config { get; set; } = new();
    [Parameter] public EventCallback<MapClickEventArgs> OnMapClick { get; set; }
    
    private IJSObjectReference? _module;
    private IJSObjectReference? _mapInstance;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeMap();
        }
    }
    
    private async Task InitializeMap()
    {
        try
        {
            Console.WriteLine("[Map] Initializing map...");
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/map.js");
            Console.WriteLine("[Map] JavaScript module loaded successfully");

            _mapInstance = await _module.InvokeAsync<IJSObjectReference>("createMap", MapContainerId, Config);
            Console.WriteLine("[Map] Map instance created successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Map] Error initializing map: {ex.Message}");
            Console.WriteLine($"[Map] Stack trace: {ex.StackTrace}");
            throw;
        }
    }
    
    public async Task UpdateLayers(List<LayerConfig> layers)
    {
        try
        {
            Console.WriteLine($"[Map] UpdateLayers called with {layers?.Count ?? 0} layers");

            if (_module == null)
            {
                Console.WriteLine("[Map] Warning: Module not initialized, skipping layer update");
                return;
            }

            if (_mapInstance == null)
            {
                Console.WriteLine("[Map] Warning: Map instance not initialized, skipping layer update");
                return;
            }

            Console.WriteLine($"[Map] Updating layers: {string.Join(", ", layers.Select(l => $"{l.Id}({l.Visible})"))}");
            await _module.InvokeVoidAsync("updateMapLayers", _mapInstance, layers);
            Console.WriteLine("[Map] Layer update completed successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Map] Error updating layers: {ex.Message}");
            Console.WriteLine($"[Map] Stack trace: {ex.StackTrace}");
            throw;
        }
    }
    
    public async ValueTask DisposeAsync()
    {
        if (_mapInstance != null && _module != null)
        {
            await _module.InvokeVoidAsync("disposeMap", _mapInstance);
        }
    }
} 