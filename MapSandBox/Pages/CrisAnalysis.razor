@page "/cris"
@using MapSandBox.Components
@using MapSandBox.Models
@using MapSandBox.Services
@inject MapLibreService MapLibreService
@inject CrisService CrisService

<PageTitle>TERRAVEX — CRIS Risk Analysis</PageTitle>

<div class="cris-container">
    <aside class="layer-sidebar">
        <div class="sidebar-content">
            <div class="control-section">
                <h3>Base Map</h3>
                <select @onchange="HandleBaseMapChange" value="@selectedBaseMapId">
                    @foreach (var style in availableStyles)
                    {
                        <option value="@style.Id">@style.Name</option>
                    }
                </select>
            </div>

            <div class="control-section">
                <h3>CRIS Layers</h3>
                @foreach (var layer in crisLayers)
                {
                    <label class="layer-toggle">
                        <input type="checkbox"
                               checked="@layer.Visible"
                               @onchange="@(e => HandleLayerToggle(new LayerToggleEventArgs(layer.Id, e.Value)))" />
                        @layer.Name
                    </label>
                }
            </div>

            <div class="control-section">
                <h3>Background Layers</h3>
                @foreach (var layer in backgroundLayers)
                {
                    <label class="layer-toggle">
                        <input type="checkbox"
                               checked="@layer.Visible"
                               @onchange="@(e => HandleLayerToggle(new LayerToggleEventArgs(layer.Id, e.Value)))" />
                        @layer.Name
                    </label>
                }
            </div>

            <div class="control-section">
                <h3>Search Location</h3>
                <div class="search-inputs">
                    <input type="number" step="any" placeholder="Latitude (32.758237)"
                           @bind="searchLatitude" class="coord-input" />
                    <input type="number" step="any" placeholder="Longitude (-97.673080)"
                           @bind="searchLongitude" class="coord-input" />
                    <button @onclick="SearchCoordinates" class="search-btn" disabled="@isSearching">
                        @if (isSearching)
                        {
                            <span>🔍 Searching...</span>
                        }
                        else
                        {
                            <span>📍 Go to Location</span>
                        }
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(searchMessage))
                {
                    <div class="search-message @searchMessageClass">@searchMessage</div>
                }
            </div>
        </div>
    </aside>

    <div class="map-section">
        <MapLibreMap @ref="mapComponent" Config="mapConfig" OnMapClick="@HandleMapClick" />
        <RoadPopup @ref="roadPopup" />
        <SoilPopup @ref="soilPopup" />
        <CrashPopup @ref="crashPopup" />
        <CrashClusterPopup @ref="crashClusterPopup" />
        <CityBoundaryPopup @ref="cityBoundaryPopup" />
        <CrisRoadSegmentPopup @ref="roadSegmentPopup" />
        <CrisIntersectionPopup @ref="intersectionPopup" />
        <RoadStressPopup @ref="roadStressPopup" />
    </div>

    <aside id="trip-panel" class="trip-panel"></aside>
</div>


@code {
    private MapLibreMap? mapComponent;
    private RoadPopup? roadPopup;
    private SoilPopup? soilPopup;
    private CrashPopup? crashPopup;
    private CrashClusterPopup? crashClusterPopup;
    private CityBoundaryPopup? cityBoundaryPopup;
    private CrisRoadSegmentPopup? roadSegmentPopup;
    private CrisIntersectionPopup? intersectionPopup;
    private RoadStressPopup? roadStressPopup;

    private MapLibreConfig mapConfig = new();
    private List<BaseMapStyle> availableStyles = new();
    private string selectedBaseMapId = "voyager";
    private List<LayerInfo> layerInfo = new();
    private List<LayerInfo> crisLayers = new();
    private List<LayerInfo> backgroundLayers = new();

    // Search functionality
    private double? searchLatitude;
    private double? searchLongitude;
    private bool isSearching = false;
    private string searchMessage = "";
    private string searchMessageClass = "";


    protected override async Task OnInitializedAsync()
    {
        mapConfig = MapLibreService.GetDefaultConfig();
        availableStyles = MapLibreService.GetAvailableBaseMapStyles();
        selectedBaseMapId = MapLibreService.GetDefaultStyleId();
        layerInfo = MapLibreService.GetLayerInfo();

        // Separate CRIS layers from background layers
        crisLayers = layerInfo.Where(l => l.Id.StartsWith("cris-")).ToList();
        backgroundLayers = layerInfo.Where(l => !l.Id.StartsWith("cris-")).ToList();
    }

    private async Task HandleBaseMapChange(ChangeEventArgs e)
    {
        selectedBaseMapId = e.Value?.ToString() ?? "voyager";
        var selectedStyle = availableStyles.FirstOrDefault(s => s.Id == selectedBaseMapId);
        if (selectedStyle != null && mapComponent != null)
        {
            await mapComponent.UpdateBaseMapStyle(selectedStyle.Url);
        }
    }

    private async Task HandleLayerToggle(LayerToggleEventArgs args)
    {
        Console.WriteLine($"Layer toggled: {args.LayerId} - {args.IsVisible}");

        // Update the layer visibility in our config
        var layer = mapConfig.Layers.FirstOrDefault(l => l.Id == args.LayerId);
        if (layer != null)
        {
            layer.Visible = args.IsVisible;

            // Update the layer info for the UI
            var layerInfoItem = layerInfo.FirstOrDefault(l => l.Id == args.LayerId);
            if (layerInfoItem != null)
            {
                layerInfoItem.Visible = args.IsVisible;
            }

            // Update the map
            if (mapComponent != null)
            {
                await mapComponent.UpdateLayers(mapConfig.Layers);
            }
        }
    }


    private void HandleMapClick(MapLibreClickEventArgs e)
    {
        // Handle map clicks if needed
    }

    private async Task SearchCoordinates()
    {
        if (!searchLatitude.HasValue || !searchLongitude.HasValue)
        {
            searchMessage = "Please enter both latitude and longitude";
            searchMessageClass = "error";
            return;
        }

        // Basic validation for Parker County area (rough bounds)
        if (searchLatitude < 32.0 || searchLatitude > 33.5 || searchLongitude < -98.5 || searchLongitude > -97.0)
        {
            searchMessage = "Coordinates appear to be outside Parker County, TX area";
            searchMessageClass = "error";
            return;
        }

        isSearching = true;
        searchMessage = "";
        StateHasChanged();

        try
        {
            if (mapComponent != null)
            {
                // Fly to the coordinates with appropriate zoom level
                await mapComponent.FlyTo(searchLatitude.Value, searchLongitude.Value, zoom: 16);

                searchMessage = $"📍 Navigated to {searchLatitude:F6}, {searchLongitude:F6}";
                searchMessageClass = "success";
            }
        }
        catch (Exception ex)
        {
            searchMessage = $"Error navigating: {ex.Message}";
            searchMessageClass = "error";
        }
        finally
        {
            isSearching = false;
            StateHasChanged();
        }
    }
}