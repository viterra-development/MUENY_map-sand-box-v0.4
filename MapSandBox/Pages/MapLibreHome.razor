@page "/"
@page "/map"
@using MapSandBox.Components
@using MapSandBox.Models
@using MapSandBox.Services
@inject MapLibreService MapLibreService
@inject IJSRuntime JS

<PageTitle>MapLibre + deck.gl</PageTitle>

<aside id="blazor-layer-sidebar" class="layer-sidebar">
    <div class="sidebar-content">
        <button class="report-btn" @onclick="ShowReportModalAsync" title="Generate a PDF summary for the selected city">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 2h7l3 3v9H3V2z" stroke="white" stroke-width="1.2" fill="none"/>
                <path d="M9 2v4h4" stroke="white" stroke-width="1.2" fill="none"/>
                <line x1="5" y1="8" x2="11" y2="8" stroke="white" stroke-width="1.2"/>
                <line x1="5" y1="11" x2="9" y2="11" stroke="white" stroke-width="1.2"/>
            </svg>
            Generate Report
        </button>
        <div class="control-section">
            <h3>Base Map</h3>
            <select @onchange="HandleBaseMapChange" value="@selectedBaseMapId">
                @foreach (var style in availableStyles)
                {
                    <option value="@style.Id">@style.Name</option>
                }
            </select>
        </div>

        <div class="control-section">
            <h3>Safety &amp; Risk</h3>
            @foreach (var layer in LayersIn(SafetyLayerIds))
            {
                <label class="layer-toggle" data-layer-tip="@LayerTip(layer.Id)">
                    <input type="checkbox"
                           checked="@layer.Visible"
                           @onchange="@(e => HandleLayerToggle(new LayerToggleEventArgs(layer.Id, e.Value)))" />
                    @layer.Name
                </label>
            }
        </div>

        <div class="control-section">
            <h3>Traffic</h3>
            @foreach (var layer in LayersIn(TrafficLayerIds))
            {
                <label class="layer-toggle" data-layer-tip="@LayerTip(layer.Id)">
                    <input type="checkbox"
                           checked="@layer.Visible"
                           @onchange="@(e => HandleLayerToggle(new LayerToggleEventArgs(layer.Id, e.Value)))" />
                    @layer.Name
                </label>
            }
        </div>

        <div class="control-section">
            <h3>Trip Generation</h3>
            <select @onchange="HandleTripGenCityChange" value="@selectedTripGenCityId" data-layer-tip="Color every parcel in a city by the daily vehicle trips it produces, with a city-wide summary panel.">
                <option value="">— Select a city —</option>
                @foreach (var layer in layerInfo.Where(l => l.Id.EndsWith("-parcels-trips")))
                {
                    <option value="@layer.Id">@TripGenCityDisplayName(layer.Name)</option>
                }
            </select>
            <label class="parcel-mode-label" for="parcel-color-mode">Color parcels by</label>
            <select id="parcel-color-mode" @onchange="HandleParcelColorModeChange" value="@selectedParcelColorMode"
                    data-layer-tip="Switch the parcel coloring between daily vehicle trips and taxable value per acre - the fiscal productivity view of the same parcels.">
                <option value="trips">Daily trips</option>
                <option value="value-acre">Value per acre ($)</option>
            </select>
        </div>

        <div class="control-section">
            <h3>Environment</h3>
            @foreach (var layer in LayersIn(EnvironmentLayerIds))
            {
                <label class="layer-toggle" data-layer-tip="@LayerTip(layer.Id)">
                    <input type="checkbox"
                           checked="@layer.Visible"
                           @onchange="@(e => HandleLayerToggle(new LayerToggleEventArgs(layer.Id, e.Value)))" />
                    @layer.Name
                </label>
            }
        </div>

        <div class="control-section">
            <h3>Base &amp; Boundaries</h3>
            @foreach (var layer in LayersIn(BaseLayerIds).Concat(UngroupedLayers()))
            {
                <label class="layer-toggle" data-layer-tip="@LayerTip(layer.Id)">
                    <input type="checkbox"
                           checked="@layer.Visible"
                           @onchange="@(e => HandleLayerToggle(new LayerToggleEventArgs(layer.Id, e.Value)))" />
                    @layer.Name
                </label>
            }
        </div>

        <button class="fiscal-soon-block" @onclick="ShowFiscalComingSoonAsync"
                data-layer-tip="The rest of the fiscal suite - net fiscal yield per acre, infrastructure payback period, and impervious burden ratio - is in development.">
            <span class="fiscal-soon-kicker">Coming soon</span>
            <span class="fiscal-soon-title">Fiscal Suite</span>
            <span class="fiscal-soon-sub">Net fiscal yield &middot; Infrastructure payback &middot; Impervious burden</span>
        </button>
    </div>
</aside>

<div id="map-wrapper">
    <MapLibreMap @ref="mapComponent" Config="mapConfig" OnMapClick="HandleMapClick" />
    <RoadPopup @ref="roadPopup" />
    <SoilPopup @ref="soilPopup" />
    <CrashPopup @ref="crashPopup" />
    <CrashClusterPopup @ref="crashClusterPopup" />
    <CityBoundaryPopup @ref="cityBoundaryPopup" />
    <CrisRoadSegmentPopup @ref="roadSegmentPopup" />
    <CrisIntersectionPopup @ref="crisIntersectionPopup" />
    <RoadStressPopup @ref="roadStressPopup" />
</div>

@* Right-side pop-out for parcel details + trip generation summary.
   parcelTripUI.js injects into #trip-panel; without this element the
   click tooltip and city stats silently drop. The trip-panel-visible
   class expands width from 0 to 320px when there's content. *@
<div id="trip-panel" class="trip-panel"></div>


@code {
    private MapLibreMap? mapComponent;
    private RoadPopup? roadPopup;
    private SoilPopup? soilPopup;
    private CrashPopup? crashPopup;
    private CrashClusterPopup? crashClusterPopup;
    private CityBoundaryPopup? cityBoundaryPopup;
    private CrisRoadSegmentPopup? roadSegmentPopup;
    private CrisIntersectionPopup? crisIntersectionPopup;
    private RoadStressPopup? roadStressPopup;
    private MapLibreConfig mapConfig = new();
    private List<LayerInfo> layerInfo = new();
    private List<BaseMapStyle> availableStyles = new();
    private string selectedBaseMapId = "voyager";
    private string selectedTripGenCityId = ""; // Which *-parcels-trips layer is currently active (empty = none)
    private string selectedParcelColorMode = "trips"; // 'trips' | 'value-acre' — mirrored into fiscal.js
    private DateTime _lastLayerToggle = DateTime.MinValue;
    private const int LayerToggleDebounceMs = 250;

    // Plain-English hover descriptions for the sidebar rows (layer-tips.js).
    private static readonly Dictionary<string, string> LayerTipText = new()
    {
        ["cris-crashes"] = "Every reported crash, colored by the most severe outcome at that spot. Shows where collisions actually happen.",
        ["cris-risk-segments"] = "Roads scored for crash risk using crash history, traffic, grade, and surface. Red segments deserve attention first.",
        ["cris-intersections"] = "Crossings ranked by crash risk - triangle size and color reflect the score. Click one for its crash record.",
        ["cris-road-stress"] = "Where growth-driven traffic demand is approaching or exceeding road capacity.",
        ["parker-roads-traffic-phase1"] = "Modeled daily traffic volume for every road, estimated from nearby count stations. Useful where no counter exists.",
        ["parker-roads-traffic"] = "Roads with TxDOT-measured daily traffic (AADT). Green = light, red = heavy.",
        ["traffic-counts"] = "TxDOT traffic count stations. Dot size and color reflect vehicles per day; click for station history.",
        ["soil-clay-visualization"] = "Clay content from the USDA soil survey. High clay swells and shrinks - a driver of pavement and foundation damage.",
        ["soil-ksat-visualization"] = "How quickly water drains into the ground. Slow-draining soils mean ponding, washouts, and drainage complaints.",
        ["noaa-rainfall-parker-points"] = "Design rainfall intensity from NOAA Atlas 14 - the numbers engineers size culverts and drainage for.",
        ["txdot-city-boundaries"] = "Incorporated city limits from TxDOT.",
        ["parker-roads-base"] = "Background road network from the U.S. Census (TIGER).",
    };
    private static string LayerTip(string id) => LayerTipText.GetValueOrDefault(id, "");

    // Sidebar grouping. Any layer not listed here (and not a *-parcels-trips
    // city layer) falls through to the Base & Boundaries group so new layers
    // can never silently disappear from the panel again.
    private static readonly string[] SafetyLayerIds = { "cris-crashes", "cris-risk-segments", "cris-intersections", "cris-road-stress" };
    private static readonly string[] TrafficLayerIds = { "parker-roads-traffic-phase1", "parker-roads-traffic", "traffic-counts" };
    private static readonly string[] EnvironmentLayerIds = { "soil-clay-visualization", "soil-ksat-visualization", "noaa-rainfall-parker-points" };
    private static readonly string[] BaseLayerIds = { "txdot-city-boundaries", "parker-roads-base" };

    private IEnumerable<LayerInfo> LayersIn(string[] ids) =>
        ids.Select(id => layerInfo.FirstOrDefault(l => l.Id == id)).Where(l => l != null).Cast<LayerInfo>();

    private IEnumerable<LayerInfo> UngroupedLayers() =>
        layerInfo.Where(l => !l.Id.EndsWith("-parcels-trips")
            && !SafetyLayerIds.Contains(l.Id) && !TrafficLayerIds.Contains(l.Id)
            && !EnvironmentLayerIds.Contains(l.Id) && !BaseLayerIds.Contains(l.Id));

    private static string TripGenCityDisplayName(string layerName)
    {
        // Layer names are formatted "Trip Generation (Willow Park)" — surface just the city.
        var openParen = layerName.IndexOf('(');
        var closeParen = layerName.IndexOf(')');
        if (openParen > 0 && closeParen > openParen)
        {
            return layerName.Substring(openParen + 1, closeParen - openParen - 1);
        }
        return layerName;
    }

    private async Task ShowReportModalAsync()
    {
        try
        {
            // report.js loads via index.html and registers window.MuenyReport.
            await JS.InvokeVoidAsync("MuenyReport.showReportModal");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MapLibreHome] Failed to open report modal: {ex.Message}");
        }
    }

    private async Task ShowFiscalComingSoonAsync()
    {
        try
        {
            // fiscal.js loads via index.html and registers window.MuenyFiscal.
            await JS.InvokeVoidAsync("MuenyFiscal.showComingSoonModal");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MapLibreHome] Failed to open fiscal coming-soon modal: {ex.Message}");
        }
    }

    private async Task HandleParcelColorModeChange(ChangeEventArgs e)
    {
        var mode = e.Value?.ToString() ?? "trips";
        selectedParcelColorMode = mode;
        try
        {
            // Set the mode in fiscal.js, then rebuild the deck.gl layers so the
            // parcel fill accessor (and the map key) pick it up.
            await JS.InvokeVoidAsync("MuenyFiscal.setParcelColorMode", mode);
            if (mapComponent != null)
            {
                await mapComponent.UpdateLayers(mapConfig.Layers);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MapLibreHome] Failed to switch parcel color mode: {ex.Message}");
        }
    }

    // Approximate city-center coordinates (Parker County, TX unless noted).
    // Used to recenter the map when a trip-gen city is picked in the dropdown.
    private static readonly Dictionary<string, (double Lat, double Lng, int Zoom)> CityCoords = new()
    {
        ["wp-parcels-trips"]            = (32.7365, -97.6506, 13),
        ["aledo-parcels-trips"]         = (32.6952, -97.6019, 13),
        ["azle-parcels-trips"]          = (32.8949, -97.5453, 13),
        ["mineral-wells-parcels-trips"] = (32.8085, -98.1128, 13),
        ["reno-parcels-trips"]          = (32.9268, -97.5734, 14),
        ["springtown-parcels-trips"]    = (32.9690, -97.6811, 13),
        ["weatherford-parcels-trips"]   = (32.7593, -97.7972, 12),
        ["hudson-oaks-parcels-trips"]   = (32.7563, -97.6989, 14),
        ["annetta-parcels-trips"]       = (32.6890, -97.6870, 13),
        ["annetta-north-parcels-trips"] = (32.7241, -97.7196, 14),
        ["annetta-south-parcels-trips"] = (32.6549, -97.7053, 14),
    };

    private async Task HandleTripGenCityChange(ChangeEventArgs e)
    {
        var newCityId = e.Value?.ToString() ?? "";
        var previousCityId = selectedTripGenCityId;
        selectedTripGenCityId = newCityId;

        // Toggle previously-selected city off (if any)
        if (!string.IsNullOrEmpty(previousCityId) && previousCityId != newCityId)
        {
            await HandleLayerToggle(new LayerToggleEventArgs(previousCityId, false));
        }
        // Toggle new selection on (if not the empty option) and recenter map
        if (!string.IsNullOrEmpty(newCityId))
        {
            await HandleLayerToggle(new LayerToggleEventArgs(newCityId, true));
            if (mapComponent != null && CityCoords.TryGetValue(newCityId, out var coords))
            {
                await mapComponent.FlyTo(coords.Lat, coords.Lng, coords.Zoom);
            }
        }
    }
    
    protected override void OnInitialized()
    {
        mapConfig = MapLibreService.GetDefaultConfig();
        layerInfo = MapLibreService.GetLayerInfo();
        availableStyles = MapLibreService.GetAvailableBaseMapStyles();
        selectedBaseMapId = MapLibreService.GetDefaultStyleId();
    }
    
    private async Task HandleLayerToggle(LayerToggleEventArgs args)
    {
        try
        {
            Console.WriteLine($"[MapLibreHome] Layer toggle requested: {args.LayerId} -> {args.IsVisible}");

            // Debounce rapid layer toggles to prevent overloading the system
            var now = DateTime.UtcNow;
            var timeSinceLastToggle = (now - _lastLayerToggle).TotalMilliseconds;

            if (timeSinceLastToggle < LayerToggleDebounceMs)
            {
                Console.WriteLine($"[MapLibreHome] Debouncing layer toggle (only {timeSinceLastToggle:F0}ms since last toggle)");
                await Task.Delay(LayerToggleDebounceMs - (int)timeSinceLastToggle);
            }

            _lastLayerToggle = DateTime.UtcNow;

            // Validate inputs
            if (string.IsNullOrEmpty(args.LayerId))
            {
                Console.WriteLine("[MapLibreHome] Error: LayerId is null or empty");
                return;
            }

            // Update the layer visibility in our config
            var layer = mapConfig.Layers.FirstOrDefault(l => l.Id == args.LayerId);
            if (layer == null)
            {
                Console.WriteLine($"[MapLibreHome] Warning: Layer '{args.LayerId}' not found in config");
                return;
            }

            Console.WriteLine($"[MapLibreHome] Updating layer '{args.LayerId}' visibility: {layer.Visible} -> {args.IsVisible}");
            layer.Visible = args.IsVisible;

            // Update the layer info for the UI
            var layerInfoItem = layerInfo.FirstOrDefault(l => l.Id == args.LayerId);
            if (layerInfoItem != null)
            {
                layerInfoItem.Visible = args.IsVisible;
                Console.WriteLine($"[MapLibreHome] Updated UI layer info for '{args.LayerId}'");
            }
            else
            {
                Console.WriteLine($"[MapLibreHome] Warning: Layer info for '{args.LayerId}' not found in UI state");
            }

            // Update the map
            if (mapComponent == null)
            {
                Console.WriteLine("[MapLibreHome] Warning: Map component is null, cannot update layers");
                return;
            }

            Console.WriteLine($"[MapLibreHome] Calling map update with {mapConfig.Layers.Count} total layers");
            await mapComponent.UpdateLayers(mapConfig.Layers);
            Console.WriteLine("[MapLibreHome] Layer toggle completed successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MapLibreHome] Error handling layer toggle: {ex.Message}");
            Console.WriteLine($"[MapLibreHome] Stack trace: {ex.StackTrace}");

            // Reset UI state in case of error
            try
            {
                var layerInfoItem = layerInfo.FirstOrDefault(l => l.Id == args.LayerId);
                if (layerInfoItem != null)
                {
                    layerInfoItem.Visible = !args.IsVisible; // Revert the change
                    StateHasChanged(); // Force UI refresh
                    Console.WriteLine($"[MapLibreHome] Reverted UI state for layer '{args.LayerId}'");
                }
            }
            catch (Exception revertEx)
            {
                Console.WriteLine($"[MapLibreHome] Error reverting UI state: {revertEx.Message}");
            }
        }
    }
    
    private async Task HandleBaseMapChange(ChangeEventArgs e)
    {
        var styleId = e.Value?.ToString();
        if (string.IsNullOrEmpty(styleId)) return;
        
        var selectedStyle = availableStyles.FirstOrDefault(s => s.Id == styleId);
        if (selectedStyle != null)
        {
            selectedBaseMapId = styleId;
            mapConfig.BaseMap.Style = selectedStyle.Url;
            mapConfig.BaseMap.Name = selectedStyle.Name;
            
            if (mapComponent != null)
            {
                await mapComponent.UpdateBaseMapStyle(selectedStyle.Url);
            }
        }
    }
    
    private void HandleMapClick(MapLibreClickEventArgs args)
    {
        Console.WriteLine($"Map clicked at: {args.Latitude}, {args.Longitude}");
        if (!string.IsNullOrEmpty(args.LayerId))
        {
            Console.WriteLine($"Clicked on layer: {args.LayerId}");
        }
    }
}