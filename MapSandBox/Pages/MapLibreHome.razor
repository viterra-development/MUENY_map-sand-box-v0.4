@page "/"
@using MapSandBox.Components
@using MapSandBox.Models
@using MapSandBox.Services
@inject MapLibreService MapLibreService

<PageTitle>MapLibre + deck.gl</PageTitle>

<aside id="blazor-layer-sidebar" class="layer-sidebar">
    <div class="sidebar-content">
        <div class="control-section">
            <h3>Base Map</h3>
            <select @onchange="HandleBaseMapChange" value="@selectedBaseMapId">
                @foreach (var style in availableStyles)
                {
                    <option value="@style.Id">@style.Name</option>
                }
            </select>
        </div>

        <div class="control-section">
            <h3>CRIS Layers</h3>
            @foreach (var layer in layerInfo.Where(l => l.Id.StartsWith("cris-")))
            {
                <label class="layer-toggle">
                    <input type="checkbox"
                           checked="@layer.Visible"
                           @onchange="@(e => HandleLayerToggle(new LayerToggleEventArgs(layer.Id, e.Value)))" />
                    @layer.Name
                </label>
            }
        </div>

        <div class="control-section">
            <h3>Trip Generation</h3>
            <select @onchange="HandleTripGenCityChange" value="@selectedTripGenCityId">
                <option value="">— Select a city —</option>
                @foreach (var layer in layerInfo.Where(l => l.Id.EndsWith("-parcels-trips")))
                {
                    <option value="@layer.Id">@TripGenCityDisplayName(layer.Name)</option>
                }
            </select>
        </div>

        <div class="control-section">
            <h3>Background Layers</h3>
            @foreach (var layer in layerInfo.Where(l => !l.Id.StartsWith("cris-") && !l.Id.EndsWith("-parcels-trips")))
            {
                <label class="layer-toggle">
                    <input type="checkbox"
                           checked="@layer.Visible"
                           @onchange="@(e => HandleLayerToggle(new LayerToggleEventArgs(layer.Id, e.Value)))" />
                    @layer.Name
                </label>
            }
        </div>
    </div>
</aside>

<div id="map-wrapper">
    <MapLibreMap @ref="mapComponent" Config="mapConfig" OnMapClick="HandleMapClick" />
    <RoadPopup @ref="roadPopup" />
    <SoilPopup @ref="soilPopup" />
    <CrashPopup @ref="crashPopup" />
    <CrashClusterPopup @ref="crashClusterPopup" />
    <CityBoundaryPopup @ref="cityBoundaryPopup" />
    <CrisRoadSegmentPopup @ref="roadSegmentPopup" />
</div>


@code {
    private MapLibreMap? mapComponent;
    private RoadPopup? roadPopup;
    private SoilPopup? soilPopup;
    private CrashPopup? crashPopup;
    private CrashClusterPopup? crashClusterPopup;
    private CityBoundaryPopup? cityBoundaryPopup;
    private CrisRoadSegmentPopup? roadSegmentPopup;
    private MapLibreConfig mapConfig = new();
    private List<LayerInfo> layerInfo = new();
    private List<BaseMapStyle> availableStyles = new();
    private string selectedBaseMapId = "voyager";
    private string selectedTripGenCityId = ""; // Which *-parcels-trips layer is currently active (empty = none)
    private DateTime _lastLayerToggle = DateTime.MinValue;
    private const int LayerToggleDebounceMs = 250;

    private static string TripGenCityDisplayName(string layerName)
    {
        // Layer names are formatted "Trip Generation (Willow Park)" — surface just the city.
        var openParen = layerName.IndexOf('(');
        var closeParen = layerName.IndexOf(')');
        if (openParen > 0 && closeParen > openParen)
        {
            return layerName.Substring(openParen + 1, closeParen - openParen - 1);
        }
        return layerName;
    }

    private async Task HandleTripGenCityChange(ChangeEventArgs e)
    {
        var newCityId = e.Value?.ToString() ?? "";
        var previousCityId = selectedTripGenCityId;
        selectedTripGenCityId = newCityId;

        // Toggle previously-selected city off (if any)
        if (!string.IsNullOrEmpty(previousCityId) && previousCityId != newCityId)
        {
            await HandleLayerToggle(new LayerToggleEventArgs(previousCityId, false));
        }
        // Toggle new selection on (if not the empty option)
        if (!string.IsNullOrEmpty(newCityId))
        {
            await HandleLayerToggle(new LayerToggleEventArgs(newCityId, true));
        }
    }
    
    protected override void OnInitialized()
    {
        mapConfig = MapLibreService.GetDefaultConfig();
        layerInfo = MapLibreService.GetLayerInfo();
        availableStyles = MapLibreService.GetAvailableBaseMapStyles();
        selectedBaseMapId = MapLibreService.GetDefaultStyleId();
    }
    
    private async Task HandleLayerToggle(LayerToggleEventArgs args)
    {
        try
        {
            Console.WriteLine($"[MapLibreHome] Layer toggle requested: {args.LayerId} -> {args.IsVisible}");

            // Debounce rapid layer toggles to prevent overloading the system
            var now = DateTime.UtcNow;
            var timeSinceLastToggle = (now - _lastLayerToggle).TotalMilliseconds;

            if (timeSinceLastToggle < LayerToggleDebounceMs)
            {
                Console.WriteLine($"[MapLibreHome] Debouncing layer toggle (only {timeSinceLastToggle:F0}ms since last toggle)");
                await Task.Delay(LayerToggleDebounceMs - (int)timeSinceLastToggle);
            }

            _lastLayerToggle = DateTime.UtcNow;

            // Validate inputs
            if (string.IsNullOrEmpty(args.LayerId))
            {
                Console.WriteLine("[MapLibreHome] Error: LayerId is null or empty");
                return;
            }

            // Update the layer visibility in our config
            var layer = mapConfig.Layers.FirstOrDefault(l => l.Id == args.LayerId);
            if (layer == null)
            {
                Console.WriteLine($"[MapLibreHome] Warning: Layer '{args.LayerId}' not found in config");
                return;
            }

            Console.WriteLine($"[MapLibreHome] Updating layer '{args.LayerId}' visibility: {layer.Visible} -> {args.IsVisible}");
            layer.Visible = args.IsVisible;

            // Update the layer info for the UI
            var layerInfoItem = layerInfo.FirstOrDefault(l => l.Id == args.LayerId);
            if (layerInfoItem != null)
            {
                layerInfoItem.Visible = args.IsVisible;
                Console.WriteLine($"[MapLibreHome] Updated UI layer info for '{args.LayerId}'");
            }
            else
            {
                Console.WriteLine($"[MapLibreHome] Warning: Layer info for '{args.LayerId}' not found in UI state");
            }

            // Update the map
            if (mapComponent == null)
            {
                Console.WriteLine("[MapLibreHome] Warning: Map component is null, cannot update layers");
                return;
            }

            Console.WriteLine($"[MapLibreHome] Calling map update with {mapConfig.Layers.Count} total layers");
            await mapComponent.UpdateLayers(mapConfig.Layers);
            Console.WriteLine("[MapLibreHome] Layer toggle completed successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MapLibreHome] Error handling layer toggle: {ex.Message}");
            Console.WriteLine($"[MapLibreHome] Stack trace: {ex.StackTrace}");

            // Reset UI state in case of error
            try
            {
                var layerInfoItem = layerInfo.FirstOrDefault(l => l.Id == args.LayerId);
                if (layerInfoItem != null)
                {
                    layerInfoItem.Visible = !args.IsVisible; // Revert the change
                    StateHasChanged(); // Force UI refresh
                    Console.WriteLine($"[MapLibreHome] Reverted UI state for layer '{args.LayerId}'");
                }
            }
            catch (Exception revertEx)
            {
                Console.WriteLine($"[MapLibreHome] Error reverting UI state: {revertEx.Message}");
            }
        }
    }
    
    private async Task HandleBaseMapChange(ChangeEventArgs e)
    {
        var styleId = e.Value?.ToString();
        if (string.IsNullOrEmpty(styleId)) return;
        
        var selectedStyle = availableStyles.FirstOrDefault(s => s.Id == styleId);
        if (selectedStyle != null)
        {
            selectedBaseMapId = styleId;
            mapConfig.BaseMap.Style = selectedStyle.Url;
            mapConfig.BaseMap.Name = selectedStyle.Name;
            
            if (mapComponent != null)
            {
                await mapComponent.UpdateBaseMapStyle(selectedStyle.Url);
            }
        }
    }
    
    private void HandleMapClick(MapLibreClickEventArgs args)
    {
        Console.WriteLine($"Map clicked at: {args.Latitude}, {args.Longitude}");
        if (!string.IsNullOrEmpty(args.LayerId))
        {
            Console.WriteLine($"Clicked on layer: {args.LayerId}");
        }
    }
}