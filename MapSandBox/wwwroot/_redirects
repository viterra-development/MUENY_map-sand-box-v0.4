# Data & framework paths — return real 404 when a file is missing so deck.gl's
# TileLayer, fetch calls, and Blazor's WASM loader all see the correct status.
# Without these rules, Cloudflare's SPA fallback rewrites every 404 to index.html,
# which corrupts geojson/wasm parsing.
/tiles/*         /404.html    404
/cris-data/*     /404.html    404
/sample-data/*   /404.html    404
/soil-data/*     /404.html    404
/_framework/*    /404.html    404

# Any other unmatched path falls through to wrangler.toml's
# not_found_handling = "single-page-application" so SPA deep links still work.
