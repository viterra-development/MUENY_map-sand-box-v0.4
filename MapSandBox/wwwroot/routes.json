{
  "routes": [
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/{*}", "/css/{*}", "/js/{*}", "/lib/{*}", "/icon-192.png", "/favicon.png", "/manifest.json", "/_framework/{*}", "/MapSandBox.styles.css"]
  }
} 